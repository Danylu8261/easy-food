# Copie este arquivo para ".env" e ajuste a senha do seu usuário postgres

# Windows / Linux (com senha definida na instalação)
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/easyfood"

# macOS (caso a instalação local não use senha), use esta linha no lugar da de cima:
# DATABASE_URL="postgresql://postgres@localhost:5432/easyfood"
