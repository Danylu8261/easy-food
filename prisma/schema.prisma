generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  rating    Float    @default(0.0)
  imageUrl  String?
  dishes    Dish[]
  createdAt DateTime @default(now())
}

model Dish {
  id           Int        @id @default(autoincrement())
  name         String
  price        Float
  description  String?
  imageUrl     String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  createdAt    DateTime   @default(now())
}

